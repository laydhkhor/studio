rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset implements a Hybrid Ownership and Role-Based Access Control (RBAC) model. 
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDoctor() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_doctor/$(request.auth.uid));
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isDoctor();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isDoctor();
      allow delete: if isDoctor();
    }

    match /roles_doctor/{doctorId} {
      // Allow public list/get to check if the app is initialized (no doctor exists yet)
      allow get, list: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/roles_doctor/$(request.auth.uid)); 
      allow update, delete: if false; 
    }

    match /doctor_profile/{doctorId} {
      allow get, list: if true;
      allow create, update: if isOwner(doctorId) || isDoctor();
      allow delete: if isDoctor();
    }

    match /app_config/{doctorId} {
      allow get, list: if true;
      allow create, update: if isDoctor();
    }

    match /patients/{patientId}/bookings/{bookingId} {
      allow get, list: if isOwner(patientId) || isDoctor();
      allow create: if (isOwner(patientId) || isDoctor()) && request.resource.data.patientId == patientId;
      allow update, delete: if isOwner(patientId) || isDoctor();
    }

    match /patients/{patientId}/prescriptions/{prescriptionId} {
      allow get, list: if isOwner(patientId) || isDoctor();
      allow create, update, delete: if isDoctor();
    }

    match /patients/{patientId}/medicine_schedules/{medicineScheduleId} {
      allow get, list: if isOwner(patientId) || isDoctor();
      allow create, update, delete: if isOwner(patientId) || isDoctor();
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.patientId) || isDoctor();
    }
  }
}