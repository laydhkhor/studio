rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SUPER ADMIN BYPASS
     * Grants absolute read/write access to the developer account.
     */
    function isSuperAdmin() {
      return request.auth != null && (request.auth.token.email == "devilcry160@gmail.com");
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPatient(data) {
      return isSignedIn() && data.patientId == request.auth.uid;
    }

    function isDoctor(data) {
      return isSignedIn() && (data.doctorId == request.auth.uid || isSuperAdmin());
    }

    function isParticipant(data) {
      return isPatient(data) || isDoctor(data);
    }

    function exists(res) {
      return res != null;
    }

    // --- Collection Rules (Fallback for other users) ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if exists(resource) && (isOwner(userId) || isDoctor(resource.data));
      allow delete: if isSuperAdmin();
    }

    match /doctorProfiles/{doctorId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(doctorId) || isSuperAdmin();
      allow update: if exists(resource) && (isOwner(doctorId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /appointments/{appointmentId} {
      allow get: if isParticipant(resource.data);
      allow list: if isSignedIn();
      allow create: if isParticipant(request.resource.data);
      allow update: if exists(resource) && isParticipant(resource.data);
      allow delete: if exists(resource) && isParticipant(resource.data);
    }

    match /prescriptions/{prescriptionId} {
      allow get: if isParticipant(resource.data);
      allow list: if isSignedIn();
      allow create: if isDoctor(request.resource.data);
      allow update: if exists(resource) && isDoctor(resource.data);
      allow delete: if isSuperAdmin();
    }

    match /medicineSchedules/{scheduleId} {
      allow get: if isPatient(resource.data);
      allow list: if isSignedIn();
      allow create: if isPatient(request.resource.data);
      allow update: if exists(resource) && isPatient(resource.data);
      allow delete: if exists(resource) && isPatient(resource.data);
    }

    match /reviews/{reviewId} {
      allow get: if resource.data.isApproved == true || isParticipant(resource.data);
      allow list: if isSignedIn();
      allow create: if isPatient(request.resource.data);
      allow update: if exists(resource) && isParticipant(resource.data);
      allow delete: if exists(resource) && isPatient(resource.data);
    }
    
    // Explicitly allow schedules for clinicians
    match /doctor_schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }
  }
}