{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user profile within the application.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "doctor", "admin"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Details about a patient's clinical booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "appointmentDateTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Declined", "Completed", "Cancelled"] },
        "type": { "type": "string" },
        "meetingLink": { "type": "string", "format": "uri" },
        "paymentId": { "type": "string" },
        "amount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "appointmentDateTime", "status"]
    },
    "Prescription": {
      "title": "Prescription",
      "description": "Digital medical prescription issued to a patient.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "issuedDate": { "type": "string", "format": "date-time" },
        "medicineItems": { "type": "array", "items": { "type": "string" } },
        "generalRemarks": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "patientId", "issuedDate"]
    }
  },
  "auth": {
    "providers": ["password", "google", "anonymous"]
  },
  "firestore": {
    "reasoning": "Using flat collections for Appointments and Prescriptions to ensure simple, performant queries and Authorization Independence during the prototyping phase."
  }
