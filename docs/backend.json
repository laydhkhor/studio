
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["patient", "doctor"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "role", "isActive", "createdAt"]
    },
    "DoctorSchedule": {
      "title": "DoctorSchedule",
      "type": "object",
      "description": "Stores the availability slots for a specific date created by the doctor.",
      "properties": {
        "date": { "type": "string", "description": "ISO Date string (YYYY-MM-DD)" },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": { "type": "string", "description": "e.g., 13:10" },
              "isBooked": { "type": "boolean" },
              "bookingId": { "type": "string" }
            }
          }
        }
      }
    },
    "Booking": {
      "title": "Booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "appointmentDateTime": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "meetingLink": { "type": "string", "format": "uri" },
        "paymentId": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "patientId", "doctorId", "appointmentDateTime", "status"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/doctor_schedules/{date}",
        "definition": {
          "entityName": "doctorSchedule",
          "schema": { "$ref": "#/backend/entities/DoctorSchedule" },
          "description": "Global availability pool managed by the doctor."
        }
      },
      {
        "path": "/patients/{patientId}/bookings/{bookingId}",
        "definition": {
          "entityName": "booking",
          "schema": { "$ref": "#/backend/entities/Booking" },
          "description": "Patient appointments."
        }
      },
      {
        "path": "/notifications/{notificationId}",
        "definition": {
          "entityName": "notification",
          "schema": { "$ref": "#/backend/entities/Notification" },
          "description": "System-wide notifications."
        }
      }
    ]
  }
}
